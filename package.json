{
  "name": "acc-form-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "dev:demo": "vite --config demo/vite.config.mjs",
    "dev:staging": "vite --mode staging --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "staging:sql": "node scripts/build-staging-sql.mjs",
    "dev:both": "node scripts/dev-both.mjs",
    "backup": "node scripts/backup.mjs",
    "local:start": "node scripts/local-db.mjs start",
    "local:stop": "node scripts/local-db.mjs stop",
    "local:reset": "node scripts/local-db.mjs reset",
    "local:sql": "node scripts/build-staging-sql.mjs --out supabase/migrations/00000000000000_full_schema.sql",
    "dev:local": "vite --mode localdb --port 5176 --strictPort"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^1.28.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.21",
    "supabase": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
