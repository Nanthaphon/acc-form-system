# ระบบทดสอบ (staging) — คัดลอกไฟล์นี้เป็น .env.staging.local แล้วใส่ค่าของ
# Supabase project ทดสอบ (ไม่ใช่ของจริง) จากนั้นรัน: npm run dev:staging
# ดูขั้นตอนเต็มที่ docs/environments.md
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key ของ project ทดสอบ>
VITE_APP_ENV=staging
